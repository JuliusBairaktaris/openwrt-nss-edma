# Wi-Fi data path.  The default is the host path: the radios stay with
# mac80211 and the NSS core is not booted.
#
#   mode 'host'         only load the drivers; never write boot=1
#   mode 'offload-once' one armed attempt; the service disarms it before it
#                       touches the core, so a hang costs one boot
#   mode 'offload'      persistent after a successful, promoted bring-up
#
# Arm an attempt with `nss-wifi-arm` (it reboots); after a successful
# offload-once boot, `nss-wifi-promote` makes it persistent.  `offload` is
# kept as the old on/off field; mode wins when it is set, and an old config
# with only offload=1 stays on the host path until it is armed.
#
#	uci set nss-wifi.general.mode='host'; uci commit nss-wifi; reboot
#
# 'firmware' is the NSS firmware line booted: '12.5', or '11.4', the line that
# forwards an 802.11s mesh.
#
# debug=1 writes fault_restart=0 for a watched bring-up: a firmware fault
# halts the core instead of restarting it.  auto_promote=1 lets a successful
# offload-once boot promote itself after 120 s; debug images keep it at 0.
# no_ahb=1 is for a QCN9074-only bring-up and skips ath11k_ahb.
#
# With CONFIG_ATH11K_NSS_WIFI set, ath11k_ahb and ath11k_pci no longer
# autoload: this service loads them.  If the nss-wifi service is disabled,
# modprobe them by hand (ath11k first, then the bus module).
config general 'general'
	option mode 'host'
	option offload '0'
	option debug '1'
	option auto_promote '0'
	option no_ahb '0'
	option firmware '12.5'
