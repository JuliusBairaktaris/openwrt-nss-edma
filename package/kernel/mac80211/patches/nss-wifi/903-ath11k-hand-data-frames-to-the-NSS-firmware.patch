Index: backports-7.2/drivers/net/wireless/ath/ath11k/dp_rx.c
===================================================================
--- backports-7.2.orig/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ backports-7.2/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -2506,6 +2506,55 @@ static void ath11k_dp_rx_deliver_msdu(st
 	ieee80211_rx_napi(ar->hw, pubsta, msdu, napi);
 }
 
+/* A frame the NSS firmware hands back as 802.11, with the receive
+ * descriptor the hardware wrote still at the head of the buffer.
+ */
+void ath11k_dp_rx_from_nss(struct ath11k *ar, struct sk_buff *msdu,
+			   struct napi_struct *napi)
+{
+	struct ath11k_skb_rxcb *rxcb = ATH11K_SKB_RXCB(msdu);
+	struct ieee80211_rx_status rx_status = {};
+
+	memset(rxcb, 0, sizeof(*rxcb));
+	rxcb->rx_desc = (struct hal_rx_desc *)msdu->head;
+	rxcb->is_first_msdu = true;
+	rxcb->is_last_msdu = true;
+
+	ath11k_dp_rx_h_ppdu(ar, rxcb->rx_desc, &rx_status);
+	ath11k_dp_rx_h_mpdu(ar, msdu, rxcb->rx_desc, &rx_status);
+
+	rx_status.flag |= RX_FLAG_SKIP_MONITOR | RX_FLAG_DUP_VALIDATED;
+
+	ath11k_dp_rx_deliver_msdu(ar, napi, msdu, &rx_status);
+}
+
+/* The NSS firmware hands up a frame the hardware did not decapsulate, such
+ * as a block ack request, on the same path as ethernet. It goes to mac80211
+ * as on the host's own receive path.
+ */
+bool ath11k_dp_rx_nss_80211(void *priv, struct net_device *dev,
+			    struct sk_buff *msdu, struct napi_struct *napi)
+{
+	struct hal_rx_desc *desc = (struct hal_rx_desc *)msdu->head;
+	struct ieee80211_vif *vif;
+
+	switch (ath11k_dp_rx_h_msdu_start_decap_type(priv, desc)) {
+	case DP_RX_DECAP_TYPE_RAW:
+	case DP_RX_DECAP_TYPE_NATIVE_WIFI:
+		break;
+	default:
+		return false;
+	}
+
+	vif = wdev_to_ieee80211_vif(dev->ieee80211_ptr);
+	if (vif)
+		ath11k_dp_rx_from_nss(ath11k_vif_to_arvif(vif)->ar, msdu, napi);
+	else
+		dev_kfree_skb_any(msdu);
+
+	return true;
+}
+
 static bool ath11k_dp_rx_check_nwifi_hdr_len_valid(struct ath11k_base *ab,
 						   struct hal_rx_desc *rx_desc,
 						   struct sk_buff *msdu)
@@ -2784,6 +2833,68 @@ exit:
 	return total_msdu_reaped;
 }
 
+/* The receive rate mac80211 reports comes from data frames, which do not
+ * reach it while the NSS firmware takes them. Take it from the PPDU status.
+ */
+static void ath11k_dp_rx_update_peer_rxrate(struct ath11k_sta *arsta,
+					    struct hal_rx_mon_ppdu_info *ppdu_info)
+{
+	/* 100 kbps, by L-SIG rate: CCK 1-7, OFDM 8-15 */
+	static const u16 legacy[] = { 0, 10, 20, 55, 110, 20, 55, 110,
+				      480, 240, 120, 60, 540, 360, 180, 90 };
+	struct rate_info r = {};
+	u8 nss = ppdu_info->nss;
+	u8 mcs = ppdu_info->mcs;
+
+	if (!ieee80211_is_data_present(cpu_to_le16(ppdu_info->frame_control)))
+		return;
+
+	switch (ppdu_info->preamble_type) {
+	case HAL_RX_PREAMBLE_11A:
+	case HAL_RX_PREAMBLE_11B:
+		r.legacy = legacy[ppdu_info->rate];
+		if (r.legacy)
+			arsta->rxrate = r;
+		return;
+	case HAL_RX_PREAMBLE_11N:
+		if (mcs > 7)
+			return;
+		r.mcs = mcs + 8 * (nss - 1);
+		r.flags = RATE_INFO_FLAGS_MCS;
+		if (ppdu_info->gi)
+			r.flags |= RATE_INFO_FLAGS_SHORT_GI;
+		break;
+	case HAL_RX_PREAMBLE_11AC:
+		if (mcs > ATH11K_VHT_MCS_MAX)
+			return;
+		r.mcs = mcs;
+		r.flags = RATE_INFO_FLAGS_VHT_MCS;
+		if (ppdu_info->gi)
+			r.flags |= RATE_INFO_FLAGS_SHORT_GI;
+		break;
+	case HAL_RX_PREAMBLE_11AX:
+		if (mcs > ATH11K_HE_MCS_MAX)
+			return;
+		/* HE-SIG-A carries space-time streams */
+		if (ppdu_info->is_stbc)
+			nss = DIV_ROUND_UP(nss, 2);
+		r.mcs = mcs;
+		r.flags = RATE_INFO_FLAGS_HE_MCS;
+		r.he_gi = ath11k_mac_he_gi_to_nl80211_he_gi(ppdu_info->gi);
+		r.he_dcm = ppdu_info->dcm;
+		break;
+	default:
+		return;
+	}
+
+	if (!nss)
+		return;
+
+	r.nss = nss;
+	r.bw = ath11k_mac_bw_to_mac80211_bw(ppdu_info->bw);
+	arsta->rxrate = r;
+}
+
 static void ath11k_dp_rx_update_peer_stats(struct ath11k_sta *arsta,
 					   struct hal_rx_mon_ppdu_info *ppdu_info)
 {
@@ -5345,6 +5456,8 @@ int ath11k_dp_rx_process_mon_status(stru
 		}
 
 		arsta = ath11k_sta_to_arsta(peer->sta);
+		if (ab->nss_offload)
+			ath11k_dp_rx_update_peer_rxrate(arsta, ppdu_info);
 		ath11k_dp_rx_update_peer_stats(arsta, ppdu_info);
 
 		if (ath11k_debugfs_is_pktlog_peer_valid(ar, peer->addr))
