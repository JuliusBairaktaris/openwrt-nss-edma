--- backports-7.2.orig/drivers/net/wireless/ath/ath11k/hal_rx.c
+++ backports-7.2/drivers/net/wireless/ath/ath11k/hal_rx.c
@@ -925,6 +925,10 @@ ath11k_hal_rx_parse_mon_status_tlv(struc
 		ppdu_info->num_mpdu_fcs_err =
 			FIELD_GET(HAL_RX_PPDU_END_USER_STATS_INFO0_MPDU_CNT_FCS_ERR,
 				  info0);
+		if (info1 & HAL_RX_PPDU_END_USER_STATS_INFO1_FC_VALID)
+			ppdu_info->frame_control =
