From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] ath11k: hand data frames to the NSS firmware

The firmware owns the transmit ring, so this driver cannot put a frame on
it, and the handover left transmit refused. A frame goes to the firmware
instead, addressed to the virtual device the firmware knows the interface
by, and a frame the firmware hands up names the same device.

The virtual device is registered once the interface's encapsulation mode
is set and released before the interface goes, so the firmware never names
one whose peers are already gone. Only an already-encapsulated frame is
handed over: the hardware builds the 802.11 header from an ethernet frame,
so a frame still carrying its own header is not one the firmware would read
the same way. Management leaves over the control path above this, unchanged.

The interface number the registration returns is what a transmitted frame
is addressed to, so it is kept with the interface rather than looked up per
frame.

Received data frames no longer pass through mac80211, which took a
station's RX bitrate from them. The rate is taken from the monitor status
ring instead, which carries the preamble type and frame control once the
PPDU end user stats TLV is enabled; the last PPDU carrying data sets it.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
---
Index: backports-7.2/drivers/net/wireless/ath/ath11k/core.h
===================================================================
--- backports-7.2.orig/drivers/net/wireless/ath/ath11k/core.h
+++ backports-7.2/drivers/net/wireless/ath/ath11k/core.h
@@ -378,6 +378,9 @@ struct ath11k_vif {
 	u8 hal_addr_search_flags;
 	u8 search_type;
 
+	/* What the NSS firmware calls this interface, or -1. */
+	int nss_ifnum;
+
 	struct ath11k *ar;
 	struct ieee80211_vif *vif;
 
@@ -562,6 +565,8 @@ struct ath11k_sta {
 	struct rate_info txrate;
 	u32 peer_nss;
 	struct rate_info last_txrate;
+	/* set only while the NSS firmware takes the data frames */
+	struct rate_info rxrate;
 	u64 rx_duration;
 	u64 tx_duration;
 	u8 rssi_comb;
Index: backports-7.2/drivers/net/wireless/ath/ath11k/mac.c
===================================================================
--- backports-7.2.orig/drivers/net/wireless/ath/ath11k/mac.c
+++ backports-7.2/drivers/net/wireless/ath/ath11k/mac.c
@@ -5,6 +5,7 @@
  */
 
 #include <net/mac80211.h>
+#include <linux/soc/qcom/nss_wifi.h>
 #include <net/cfg80211.h>
 #include <linux/etherdevice.h>
 #include <linux/bitfield.h>
@@ -229,6 +230,7 @@ ath11k_phymodes[NUM_NL80211_BANDS][ATH11
 const struct htt_rx_ring_tlv_filter ath11k_mac_mon_status_filter_default = {
 	.rx_filter = HTT_RX_FILTER_TLV_FLAGS_MPDU_START |
 		     HTT_RX_FILTER_TLV_FLAGS_PPDU_END |
+		     HTT_RX_FILTER_TLV_FLAGS_PPDU_END_USER_STATS |
 		     HTT_RX_FILTER_TLV_FLAGS_PPDU_END_STATUS_DONE,
 	.pkt_filter_flags0 = HTT_RX_FP_MGMT_FILTER_FLAGS0,
 	.pkt_filter_flags1 = HTT_RX_FP_MGMT_FILTER_FLAGS1,
@@ -6536,14 +6538,17 @@ static void ath11k_mac_op_tx(struct ieee
 		return;
 	}
 
-	/* The transmit ring belongs to the firmware, which reaps its own
-	 * completions by a cookie it minted and resolves that cookie to one
-	 * of its own descriptors. A frame the host puts there completes as a
-	 * descriptor the firmware never handed out. Management has already
-	 * left over the control path above.
+	/* The transmit ring belongs to the firmware, so a frame goes to the
+	 * virtual device the firmware knows this interface by instead. Only
+	 * an already-encapsulated one: the hardware builds the 802.11 header
+	 * from the ethernet frame, and anything still carrying its own is a
+	 * frame nothing downstream of here would read the same way.
+	 * Management has already left over the control path above.
 	 */
 	if (ath11k_nss_offload) {
-		ieee80211_free_txskb(ar->hw, skb);
+		if (!(info_flags & IEEE80211_TX_CTL_HW_80211_ENCAP) ||
+		    nss_wifi_vdev_tx(arvif->nss_ifnum, skb))
+			ieee80211_free_txskb(ar->hw, skb);
 		return;
 	}
 
@@ -6871,6 +6876,37 @@ static int ath11k_mac_setup_vdev_create_
 	return 0;
 }
 
+/* Give the NSS firmware a virtual device for this interface.
+ *
+ * The firmware addresses a transmitted frame to a virtual device and names
+ * the same device on a frame it hands up, so the network device is what the
+ * registration binds the number to. Frames across it are ethernet, which is
+ * what the hardware encapsulation and decapsulation this driver has already
+ * been told to use produce.
+ */
+static void ath11k_nss_vdev_register(struct ath11k_vif *arvif,
+				     struct ieee80211_vif *vif)
+{
+	struct ath11k *ar = arvif->ar;
+	struct wireless_dev *wdev;
+	int ret;
+
+	wdev = ieee80211_vif_to_wdev(vif);
+	if (!wdev || !wdev->netdev)
+		return;
+
+	ret = nss_wifi_vdev_register(wdev->netdev, ar->pdev_idx, arvif->vdev_id,
+				     vif->addr,
+				     vif->type == NL80211_IFTYPE_AP);
+	if (ret < 0) {
+		ath11k_warn(ar->ab, "failed to give vdev %d to the NSS firmware: %d\n",
+			    arvif->vdev_id, ret);
+		return;
+	}
+
+	arvif->nss_ifnum = ret;
+}
+
 static void ath11k_mac_op_update_vif_offload(struct ieee80211_hw *hw,
 					     struct ieee80211_vif *vif)
 {
@@ -7117,6 +7153,7 @@ static int ath11k_mac_op_add_interface(s
 
 	arvif->ar = ar;
 	arvif->vif = vif;
+	arvif->nss_ifnum = -1;
 
 	INIT_LIST_HEAD(&arvif->list);
 	INIT_WORK(&arvif->bcn_tx_work, ath11k_mac_bcn_tx_work);
@@ -7202,6 +7239,9 @@ static int ath11k_mac_op_add_interface(s
 
 	ath11k_mac_op_update_vif_offload(hw, vif);
 
+	if (ath11k_nss_offload)
+		ath11k_nss_vdev_register(arvif, vif);
+
 	nss = get_num_chains(ar->cfg_tx_chainmask) ? : 1;
 	ret = ath11k_wmi_vdev_set_param_cmd(ar, arvif->vdev_id,
 					    WMI_VDEV_PARAM_NSS, nss);
@@ -7384,6 +7424,17 @@ static void ath11k_mac_op_remove_interfa
 				    arvif->vdev_id, ret);
 	}
 
+	/* Before the vdev goes, so the firmware stops naming an interface
+	 * whose peers are already gone.
+	 */
+	if (arvif->nss_ifnum >= 0) {
+		struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+
+		if (wdev && wdev->netdev)
+			nss_wifi_vdev_unregister(wdev->netdev);
+		arvif->nss_ifnum = -1;
+	}
+
 	ret = ath11k_mac_vdev_delete(ar, arvif);
 	if (ret) {
 		ath11k_warn(ab, "failed to delete vdev %d: %d\n",
@@ -9459,6 +9510,11 @@ static void ath11k_mac_op_sta_statistics
 		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_BITRATE);
 	}
 
+	if (arsta->rxrate.legacy || arsta->rxrate.nss) {
+		sinfo->rxrate = arsta->rxrate;
+		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_RX_BITRATE);
+	}
+
 	ath11k_mac_put_chain_rssi(sinfo, arsta, "ppdu", false);
 
 	mutex_lock(&ar->conf_mutex);
Index: backports-7.2/drivers/net/wireless/ath/ath11k/hal_rx.c
===================================================================
--- backports-7.2.orig/drivers/net/wireless/ath/ath11k/hal_rx.c
+++ backports-7.2/drivers/net/wireless/ath/ath11k/hal_rx.c
@@ -925,6 +925,10 @@ ath11k_hal_rx_parse_mon_status_tlv(struc
 		ppdu_info->num_mpdu_fcs_err =
 			FIELD_GET(HAL_RX_PPDU_END_USER_STATS_INFO0_MPDU_CNT_FCS_ERR,
 				  info0);
+		if (info1 & HAL_RX_PPDU_END_USER_STATS_INFO1_FC_VALID)
+			ppdu_info->frame_control =
+				FIELD_GET(HAL_RX_PPDU_END_USER_STATS_INFO2_FRAME_CTRL,
+					  __le32_to_cpu(eu_stats->info2));
 		switch (ppdu_info->preamble_type) {
 		case HAL_RX_PREAMBLE_11N:
 			ppdu_info->ht_flags = 1;
