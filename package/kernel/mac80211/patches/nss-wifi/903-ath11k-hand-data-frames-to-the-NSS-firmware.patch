+	/* What the NSS firmware calls this interface, or -1. */
+	int nss_ifnum;
+
 	struct ath11k *ar;
 	struct ieee80211_vif *vif;
 
@@ -562,6 +566,8 @@ struct ath11k_sta {
 	struct rate_info txrate;
 	u32 peer_nss;
 	struct rate_info last_txrate;
+	/* set only while the NSS firmware takes the data frames */
+	struct rate_info rxrate;
 	u64 rx_duration;
