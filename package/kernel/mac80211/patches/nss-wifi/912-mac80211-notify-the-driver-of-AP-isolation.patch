From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] mac80211: notify the driver of AP isolation

AP isolation is kept in an interface flag, so a driver whose device
forwards between the stations of a BSS itself never learns of it. Store
it in the BSS configuration and report changes with
BSS_CHANGED_AP_ISOLATE, also on reconfiguration.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
---
diff --git a/include/net/mac80211.h b/include/net/mac80211.h
index 024ac3c..9be9083 100644
--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -443,6 +443,7 @@ struct ieee80211_vif_chanctx_switch {
  * @BSS_CHANGED_TPE: transmit power envelope changed
  * @BSS_CHANGED_NAN_LOCAL_SCHED: NAN local schedule changed (NAN mode only)
  * @BSS_CHANGED_NPCA: NPCA parameters changed
+ * @BSS_CHANGED_AP_ISOLATE: AP isolation changed (AP mode)
  */
 enum ieee80211_bss_change {
 	BSS_CHANGED_ASSOC		= 1<<0,
@@ -482,6 +483,7 @@ enum ieee80211_bss_change {
 	BSS_CHANGED_TPE			= BIT_ULL(35),
 	BSS_CHANGED_NAN_LOCAL_SCHED	= BIT_ULL(36),
 	BSS_CHANGED_NPCA		= BIT_ULL(37),
+	BSS_CHANGED_AP_ISOLATE		= BIT_ULL(38),
 
 	/* when adding here, make sure to change ieee80211_reconfig */
 };
@@ -781,6 +783,7 @@ struct ieee80211_bss_npca_params {
  * @ftm_responder: whether to enable or disable fine timing measurement FTM
  *	responder functionality.
  * @ftmr_params: configurable lci/civic parameter when enabling FTM responder.
+ * @ap_isolate: frames between stations of this BSS are not forwarded
  * @nontransmitted: this BSS is a nontransmitted BSS profile
  * @tx_bss_conf: Pointer to the BSS configuration of transmitting interface
  *	if MBSSID is enabled. This pointer is RCU-protected due to CSA finish
@@ -913,6 +916,7 @@ struct ieee80211_bss_conf {
 	bool protected_keep_alive;
 	bool ftm_responder;
 	struct ieee80211_ftm_responder_params *ftmr_params;
+	bool ap_isolate;
 	/* Multiple BSSID data */
 	bool nontransmitted;
 	struct ieee80211_bss_conf __rcu *tx_bss_conf;
diff --git a/net/mac80211/cfg.c b/net/mac80211/cfg.c
index 26e78a3..a95884c 100644
--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -3403,6 +3403,8 @@ static int ieee80211_change_bss(struct wiphy *wiphy,
 		else
 			sdata->flags &= ~IEEE80211_SDATA_DONT_BRIDGE_PACKETS;
 		ieee80211_check_fast_rx_iface(sdata);
+		link->conf->ap_isolate = params->ap_isolate;
+		changed |= BSS_CHANGED_AP_ISOLATE;
 	}
 
 	if (params->ht_opmode >= 0) {
diff --git a/net/mac80211/util.c b/net/mac80211/util.c
index 59f73da..9da3831 100644
--- a/net/mac80211/util.c
+++ b/net/mac80211/util.c
@@ -2186,6 +2186,9 @@ int ieee80211_reconfig(struct ieee80211_local *local)
 			if (sdata->vif.type == NL80211_IFTYPE_AP) {
 				changed |= BSS_CHANGED_AP_PROBE_RESP;
 
+				if (sdata->vif.bss_conf.ap_isolate)
+					changed |= BSS_CHANGED_AP_ISOLATE;
+
 				if (ieee80211_vif_is_mld(&sdata->vif)) {
 					ieee80211_reconfig_ap_links(local,
 								    sdata,
