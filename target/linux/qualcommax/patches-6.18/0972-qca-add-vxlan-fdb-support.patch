qualcommax: ipq8074: add vxlan fdb-notify + age-update kernel support

qca-nss-ecm (and the qca-nss vxlanmgr client) call vxlan_fdb_update_mac()
and the vxlan_fdb notifier chain, which the upstream vxlan driver does not
provide. With kmod-vxlan selected, the ECM Makefile turns on
ECM_INTERFACE_VXLAN_ENABLE and ecm_interface.c then fails to build:
  error: implicit declaration of function 'vxlan_fdb_update_mac'

Add the QCA vxlan hooks to the kernel vxlan driver (faithful port of
qosmio's 0603-5-qca-nss-clients-add-vxlan-support, re-anchored to 6.12.94
whose vxlan_xmit_one uses ip_hdr(skb) rather than old_iph):
  - vxlan_fdb_update_mac(): refresh an fdb entry's age (what ECM calls);
  - vxlan_fdb_register/unregister_notify + a vxlan_fdb notifier fired from
    __vxlan_fdb_notify (for the vxlanmgr client);
  - reset skb->skb_iif to the tunnel ifindex on the v4/v6 tx paths so the
    encapsulated frame carries the right ingress for offload classification.

All additions live in drivers/net/vxlan/, which is compiled only when
kmod-vxlan is selected, so the default AX3600 image (no vxlan) is unaffected.

--- a/drivers/net/vxlan/vxlan_core.c
+++ b/drivers/net/vxlan/vxlan_core.c
@@ -31,6 +31,20 @@
 #include <net/vxlan.h>
 #include <net/nexthop.h>
 
+ATOMIC_NOTIFIER_HEAD(vxlan_fdb_notifier_list);
+
+void vxlan_fdb_register_notify(struct notifier_block *nb)
+{
+	atomic_notifier_chain_register(&vxlan_fdb_notifier_list, nb);
+}
+EXPORT_SYMBOL(vxlan_fdb_register_notify);
+
+void vxlan_fdb_unregister_notify(struct notifier_block *nb)
+{
+	atomic_notifier_chain_unregister(&vxlan_fdb_notifier_list, nb);
+}
+EXPORT_SYMBOL(vxlan_fdb_unregister_notify);
+
 #if IS_ENABLED(CONFIG_IPV6)
 #include <net/ip6_tunnel.h>
 #include <net/ip6_checksum.h>
@@ -266,6 +280,7 @@ static void __vxlan_fdb_notify(struct vx
 {
 	struct net *net = dev_net(vxlan->dev);
 	struct sk_buff *skb;
+	struct vxlan_fdb_event vfe;
 	int err = -ENOBUFS;
 
 	skb = nlmsg_new(vxlan_nlmsg_size(), GFP_ATOMIC);
@@ -281,6 +296,10 @@ static void __vxlan_fdb_notify(struct vx
 	}
 
 	rtnl_notify(skb, net, 0, RTNLGRP_NEIGH, NULL, GFP_ATOMIC);
+	vfe.dev = vxlan->dev;
+	vfe.rdst = rd;
+	ether_addr_copy(vfe.eth_addr, fdb->eth_addr);
+	atomic_notifier_call_chain(&vxlan_fdb_notifier_list, type, (void *)&vfe);
 	return;
 errout:
 	rtnl_set_sk_err(net, RTNLGRP_NEIGH, err);
@@ -423,6 +442,18 @@ static struct vxlan_fdb *vxlan_find_mac(
 	return f;
 }
 
+/* Find and update age of fdb entry corresponding to MAC. */
+void vxlan_fdb_update_mac(struct vxlan_dev *vxlan, const u8 *mac, uint32_t vni)
+{
+	u32 hash_index;
+
+	hash_index = fdb_head_index(vxlan, mac, vni);
+	spin_lock_bh(&vxlan->hash_lock[hash_index]);
+	vxlan_find_mac_tx(vxlan, mac, vni);
+	spin_unlock_bh(&vxlan->hash_lock[hash_index]);
+}
+EXPORT_SYMBOL(vxlan_fdb_update_mac);
+
 /* caller should hold vxlan->hash_lock */
 static struct vxlan_rdst *vxlan_fdb_find_rdst(struct vxlan_fdb *f,
 					      union vxlan_addr *ip, __be16 port,
@@ -2532,6 +2563,9 @@ void vxlan_xmit_one(struct sk_buff *skb,
 			goto out_unlock;
 		}
 
+		/* Reset the skb_iif to Tunnels interface index */
+		skb->skb_iif = dev->ifindex;
+
 		tos = ip_tunnel_ecn_encap(tos, ip_hdr(skb), skb);
 		ttl = ttl ? : ip4_dst_hoplimit(&rt->dst);
 		err = vxlan_build_skb(skb, ndst, sizeof(struct iphdr),
@@ -2616,6 +2650,9 @@ void vxlan_xmit_one(struct sk_buff *skb,
 			goto tx_error;
 		}
 
+		/* Reset the skb_iif to Tunnels interface index */
+		skb->skb_iif = dev->ifindex;
+
 		udp_tunnel6_xmit_skb(ndst, sock6->sock->sk, skb, dev,
 				     &saddr, &pkey->u.ipv6.dst, tos, ttl,
 				     pkey->label, src_port, dst_port, !udp_sum,
--- a/include/net/vxlan.h
+++ b/include/net/vxlan.h
@@ -358,6 +358,19 @@ struct vxlan_dev {
 					 VXLAN_F_MC_ROUTE          |	\
 					 0)
 
+/*
+ * Application data for fdb notifier event
+ */
+struct vxlan_fdb_event {
+	struct net_device *dev;
+	struct vxlan_rdst *rdst;
+	u8 eth_addr[ETH_ALEN];
+};
+
+extern void vxlan_fdb_register_notify(struct notifier_block *nb);
+extern void vxlan_fdb_unregister_notify(struct notifier_block *nb);
+extern void vxlan_fdb_update_mac(struct vxlan_dev *vxlan, const u8 *mac, uint32_t vni);
+
 struct net_device *vxlan_dev_create(struct net *net, const char *name,
 				    u8 name_assign_type, struct vxlan_config *conf);
 
