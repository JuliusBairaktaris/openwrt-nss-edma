#!/bin/sh
# Offload routed flows to the PPE and NSS unless the options were set already.
[ -n "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" ] && exit 0
uci -q batch <<-EOT
	set firewall.@defaults[0].flow_offloading='1'
	set firewall.@defaults[0].flow_offloading_hw='1'
	commit firewall
EOT
exit 0
